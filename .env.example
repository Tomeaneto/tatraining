# Strava — crie o app em https://www.strava.com/settings/api
# Usadas só nas Vercel Functions (/api). O secret nunca vai para o frontend.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Exposto ao frontend (precisa do prefixo VITE_) para montar a URL de autorização.
VITE_STRAVA_CLIENT_ID=

# Supabase — Project Settings → API (ou Connect) no painel do projeto.
# Expostas ao frontend: login e sincronização. A anon key é pública por design; o RLS protege os dados.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# SOMENTE servidor (Vercel Functions): grava os tokens do Strava em strava_connections.
# Nunca use o prefixo VITE_ nesta chave — ela ignora o RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: as funções usam VITE_SUPABASE_URL se esta ficar vazia.
SUPABASE_URL=

# Telegram + Gemini (dieta) — SOMENTE servidor. Veja "Bot do Telegram (dieta)" no README.
TELEGRAM_BOT_TOKEN=
# Texto aleatório longo; o Telegram o envia em cada chamada do webhook.
TELEGRAM_WEBHOOK_SECRET=
GEMINI_API_KEY=
# Opcionais
GEMINI_MODEL=gemini-2.5-flash
APP_TIMEZONE=America/Sao_Paulo
